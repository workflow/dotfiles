+/// A jj command run in `dir`. jj refuses to run in a stale working copy (one
+/// whose @ was rewritten from another workspace), so update it the way
+/// `jj workspace update-stale` would; unrecorded edits survive in a divergent
+/// sibling of @.
+fn jj_in(dir: impl AsRef<Path>) -> Command {
+    let mut cmd = Command::new("jj");
+    cmd.current_dir(dir)
+        .args(["--config", "snapshot.auto-update-stale=true"]);
+    cmd
+}
