+fn removable_workspace_root(cwd: &str) -> PathBuf {
+    if cwd.is_empty() {
+        fail("no focused pane cwd in the plugin context");
+    }
+    let canon = fs::canonicalize(cwd).unwrap_or_else(|err| fail(&format!("cannot resolve {cwd}: {err}")));
+    let root = workspace_root_of(&canon).unwrap_or_else(|| fail(&format!("{} is not inside a jj workspace", canon.display())));
+    // The MAIN workspace stores .jj/repo as a directory; a secondary workspace
+    // stores it as a file pointer. Never remove the main workspace.
+    if root.join(".jj").join("repo").is_dir() {
+        fail(&format!("refusing to remove the MAIN jj workspace ({})", root.display()));
+    }
+    if root.parent().is_none() {
+        fail(&format!("refusing to remove unsafe path: {}", root.display()));
+    }
+    root
+}
+
+fn workspace_root_of(path: &Path) -> Option<PathBuf> {
+    path.ancestors()
+        .find(|dir| dir.join(".jj").is_dir())
+        .map(Path::to_path_buf)
+}
+
+/// Recorded state only: the preview must not touch the checkout, and
+/// `workspace forget` snapshots on-disk edits into @ before the folder goes.
+fn commits_outside_trunk(root: &Path) -> String {
+    let output = Command::new("jj")
+        .current_dir(root)
+        .args([
+            "--ignore-working-copy",
+            "log",
+            "--no-graph",
+            "-r",
+            "(trunk()..@) ~ (empty() & description(exact:\"\"))",
+            "-T",
+            "change_id.short() ++ \" \" ++ description.first_line() ++ \"\\n\"",
+        ])
+        .output();
+    match output {
+        Ok(output) if output.status.success() => String::from_utf8_lossy(&output.stdout).into_owned(),
+        _ => "(could not list them: jj log failed)\n".into(),
+    }
+}
+
+fn removal_prompt(root: &Path, outside_trunk: &str) -> String {
+    let name = root.file_name().and_then(|n| n.to_str()).unwrap_or("?");
+    let mut prompt = format!("Remove jj workspace {name}?\n  {}\n\n", root.display());
+    if outside_trunk.trim().is_empty() {
+        prompt.push_str("Nothing outside trunk() is checked out here.\n");
+    } else {
+        prompt.push_str("Not in trunk() (kept in the repo, but no longer checked out anywhere):\n");
+        for line in outside_trunk.lines() {
+            prompt.push_str(&format!("  {line}\n"));
+        }
+    }
+    prompt.push_str("\nThe folder is deleted, including ignored files (.env, build output), and its tab closes.\n");
+    prompt.push_str("Remove? [y/N] ");
+    prompt
+}
+
+fn confirms_removal(answer: &str) -> bool {
+    matches!(answer.trim().to_lowercase().as_str(), "y" | "yes")
+}
